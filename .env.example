# Copy this file to `.env.local` and fill in your values.
# Next.js loads `.env.local` automatically (it is gitignored).

# -----------------------------------------------------------------------------
# Resend — required. Contact form emails vip@premierentertainment.events.
# From-address domain must be verified in Resend. Until
# premierentertainment.events is verified, send from the Advertisement domain.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL=Premier Entertainment <hello@premieradvertisement.com>

# -----------------------------------------------------------------------------
# Postgres — required. Stores the contact CRM (pe_contacts).
# Do not run prisma migrate reset against a shared database.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# CRM sign-in at /crm
# -----------------------------------------------------------------------------
CRM_PASSWORD=
CRM_SECRET=
